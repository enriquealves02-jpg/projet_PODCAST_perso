# Groq API (gratuit : https://console.groq.com)
GROQ_API_KEY=

# Email config (Gmail avec App Password)
# Pour Gmail : https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=ton.email@gmail.com
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_TO=ton.email@gmail.com

# --- Optionnel ---
# Mettre a 1 UNIQUEMENT en local derriere un proxy d'entreprise qui intercepte le TLS.
# Laisser vide partout ailleurs (GitHub Actions) pour garder la verification SSL active.
INSECURE_SSL=
# Surcharge des modeles Groq sans toucher au code (laisser vide = valeurs par defaut).
# Defauts actuels : openai/gpt-oss-20b (filtre) et openai/gpt-oss-120b (resumes).
FILTER_MODEL=
SUMMARIZER_MODEL=
